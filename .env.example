# ==========================================
# Server
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Firebase Admin SDK
# ==========================================
# مسار ملف Service Account (لا تضع محتواه هنا)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# معرف مشروع Firebase
FIREBASE_PROJECT_ID=ueser-7cba7


# ==========================================
# CORS
# ==========================================
# في الإنتاج ضع نطاق موقعك فقط
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
